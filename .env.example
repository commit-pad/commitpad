# Copy to .env.local and fill in the production values. Never commit .env.local.
COMMIT_PUBLIC_ORIGIN=https://commit.example
COMMIT_DATA_DIR=/var/lib/commit
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
COMMIT_SESSION_KEY=
# Explicitly allow a public deployment before GitHub OAuth is configured.
# Sign-in and all repository launches stay unavailable when credentials are absent.
COMMIT_PUBLIC_PREVIEW=0
# Comma-separated immutable GitHub user IDs allowed to approve/settle payout requests.
# The commit-pad account is GitHub user ID 334859250. No operator is enabled when blank.
COMMIT_PAYOUT_ADMIN_IDS=

# Server-only Solana RPC supporting simulations, balances, and finalized history.
SOLANA_RPC_URL=https://solana-rpc.publicnode.com
# Optional DAS-compatible getTokenAccounts indexer, for complete holder counts.
SOLANA_INDEXER_URL=
# Optional server-only GitHub read token for background public repository updates.
# Never use a VITE_ prefix for credentials. Interactive reads use the user's OAuth token.
GITHUB_READ_TOKEN=

HOST=127.0.0.1
PORT=5190
# Enable only when a reverse proxy connects from loopback and overwrites forwarding headers.
PAWN_TRUST_PROXY=loopback
# Match the tested Pawns production setting.
NODE_OPTIONS=--no-addons
